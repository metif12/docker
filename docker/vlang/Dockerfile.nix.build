# Hermetic toolchain image for V, with the compiler and build tools coming from
# a pinned nixpkgs revision instead of `apk add` / `apt install`.
#
# This is what makes the `nix` variants different from `alpine` and `debian`:
# the image contents change only when NIXPKGS_REV changes, so a build that
# worked last week works byte for byte this week.
#
# Used as the builder stage of the multi-stage Dockerfile.nix, and as the image
# the `nix` job of build.yml builds and pushes.
FROM nixos/nix:latest

# Declared inside the build stage on purpose: an ARG declared before the first
# FROM is not in scope after it, so a global declaration would substitute an
# empty string into the URL below and the build would fetch all of nixpkgs
# instead of the requested revision.
ARG NIXPKGS_REV=39ad350a0602fa0a58a544344e3e9187526ea45c

ENV NIXPKGS_REV=${NIXPKGS_REV}

LABEL org.opencontainers.image.title="thevlang/vlang:nix-build"
LABEL org.opencontainers.image.description="Nix toolchain image for building V from source"
LABEL org.opencontainers.image.source="https://github.com/vlang/docker"
LABEL org.opencontainers.image.licenses="MIT"
LABEL maintainer="V contributors <https://github.com/vlang/docker>"

# `nix-env -f <tarball> -iA ...` installs from one pinned nixpkgs commit, with no
# channel in the way, so the same NIXPKGS_REV always yields the same store paths.
RUN nix-env -f "https://github.com/NixOS/nixpkgs/archive/${NIXPKGS_REV}.tar.gz" -iA \
    # Git support
    git \
    # V build dependencies
    make gcc \
    # pkg-config lets `nix-shell -p <pkg>` inside the container resolve the
    # development headers of any nixpkgs library
    pkg-config \
    # Libraries V links against when they are present
    openssl sqlite

# `nix-env -i` as root installs into /root/.nix-profile, which the base image
# does not already put on PATH.
ENV PATH=/root/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/usr/bin:/bin

WORKDIR /opt/vlang

CMD ["bash"]
