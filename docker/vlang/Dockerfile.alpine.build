# Builder image with alpine base, used as builder stage
# for multi-stage builds. Also base for full dev image
# - All dependecies
# - clang compiler (and gcc needed for clang to work on alpine)
# - nodejs for js backend

ARG USER=thevlang

# Stage 1 - Build the V-compiler
FROM ${USER}/vlang:alpine-base

# Add the build dependencies
RUN apk --no-cache add \
    # Git support
    git openssh-client \
    # js back-end
    nodejs npm  \
    # V-development dependencies
    make musl-dev valgrind clang gcc \
    # Boehm GC, which V links against in its default GC mode. Without it
    # `make` gets as far as building ./v and then fails at `@./v -version`,
    # where V populates its module cache for the builtin module with the
    # default GC: "C library `gc:` was not found while linking the generated
    # program."
    gc gc-dev \
    # V-UI dependencies
    libx11-dev glfw-dev freetype-dev \
    # compilation/optimization utilities
    upx