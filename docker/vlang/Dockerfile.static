# Minimal `scratch`-based image holding a fully static V compiler.
#
# What it is for:
#   * A base image for an already-compiled static V program:
#       FROM thevlang/vlang:static
#       COPY --from=build /app/program /usr/local/bin/program
#       CMD ["program"]
#   * `v version`.
#
# What it is deliberately not: a compiler. There is no C compiler in this image
# and V shells out to one for every `v run` / `v build`, so those do not work
# here. `v fmt`, `v doc` and the other subcommands are driven by building
# `cmd/tools/<tool>` from the V source tree (see cmd/v/v.v:find_vroot, which
# looks for a GNUmakefile next to vlib/v, and launch_external_tool, which
# compiles the tool and caches it), so they need both a C compiler and a source
# tree that this image does not carry. Use `:alpine`, `:debian` or `:nix` to
# build programs.
#
# Measured on Linux x86_64 (gcc 13, V 0.5.2 5bd6709): `make VFLAGS='-prod'
# CFLAGS='-static' LDFLAGS='-static'` exits 0 and produces a 19 MB binary that
# `ldd` reports as "not a dynamic executable". From a tree holding only `v` and
# `vlib`, `v version` works and `v -gc none run` works when a C compiler is
# reachable; the whole thing is ~66 MB, against ~100 MB for the debian/alpine
# runtime images.
#
# `--build-arg V_REV=<tag|sha|branch>` selects what is built, so a release image
# can be built from the tag it is named after. The default is V master.
ARG V_REV=master

# Stage 1 - build a static V on Alpine/musl.
# musl is what makes a useful static link possible here: V ships no shared
# libraries of its own (`make` builds with `-gc none` by default), so the only
# dynamic dependency to remove is libc.
FROM alpine:3.23 AS builder

RUN apk --no-cache add build-base git

WORKDIR /opt/vlang

# CFLAGS and LDFLAGS are picked up by the V Makefile and forwarded to the C
# compiler as -cflags / -ldflags (see the `v` target in the Makefile). The
# build directory is also the install directory: V bakes the location of its
# own stdlib into the binary at compile time (vlib/v/pref/pref.v:detect_vroot
# and the @VMODROOT handling in vlib/v/parser/parser.v:12149), so building
# anywhere other than the runtime path yields a compiler that cannot find vlib.
#
# The fetch-and-checkout is what makes `--build-arg V_REV=<tag>` build exactly
# that revision. Without it the clone would silently build whatever master is
# when the layer happens to be cached.
ARG V_REV
RUN git clone --depth 1 https://github.com/vlang/v . && \
    git fetch --quiet --depth 1 origin "${V_REV}" && \
    git checkout --quiet FETCH_HEAD && \
    make VFLAGS='-prod' CFLAGS='-static' LDFLAGS='-static' && \
    v -version

# Stage 2 - the image. `FROM scratch` means no libc, no loader and no shell, so
#           the binary really does have to be static.
FROM scratch

COPY --from=builder /opt/vlang/v /opt/vlang/v
COPY --from=builder /opt/vlang/vlib /opt/vlang/vlib
COPY --from=builder /opt/vlang/v.mod /opt/vlang/v.mod

# V writes its module cache and temp files under the home directory, which has
# to be writable - in this image that is /tmp.
ENV VEXE=/opt/vlang/v \
    HOME=/tmp \
    VMODULES=/tmp/vmodules \
    VTMP=/tmp/v

# A static binary still reads these for TLS and for user lookups.
COPY --from=builder /etc/passwd /etc/passwd
COPY --from=builder /etc/group /etc/group
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

WORKDIR /src

CMD ["v"]
